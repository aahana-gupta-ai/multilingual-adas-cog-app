{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource catalog",
  "type": "object",
  "required": [
    "project",
    "items"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/|.*\\.\\.).+"
          }
        }
      }
    }
  }
}
